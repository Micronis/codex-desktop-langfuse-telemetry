# Copy to .env (gitignored) and source before install scripts.
# Never commit real values.

# Langfuse project keys for the metadata-only project `codex-desktop`
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Basic auth header value: base64(public:secret) — or let scripts derive it
LANGFUSE_OTLP_AUTHORIZATION=

# Generated locally for Langfuse chart secrets
NEXTAUTH_SECRET=
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_PASSWORD=

# Grafana local admin
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Optional content-capture project (separate credentials)
LANGFUSE_CONTENT_PUBLIC_KEY=
LANGFUSE_CONTENT_SECRET_KEY=
