{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex-sse-event-v1",
  "title": "Codex SSE / OTel log event adapter v1",
  "description": "Versioned allowlist of event types and fields. Update only after a sanitized canary sample is inspected (SPEC §7.2).",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_type", "event_id", "time"],
  "properties": {
    "event_type": {
      "type": "string",
      "enum": [
        "codex.sse_event",
        "codex.api_request",
        "codex.tool_decision",
        "codex.tool_result"
      ]
    },
    "event_id": { "type": "string" },
    "time": { "type": "string" },
    "conversation_id": { "type": "string" },
    "agent_id": { "type": "string" },
    "thread_id": { "type": "string" },
    "parent_conversation_id": { "type": "string" },
    "model": { "type": "string" },
    "reasoning_effort": { "type": "string" },
    "sse_type": { "type": "string" },
    "input_tokens": { "type": "integer", "minimum": 0 },
    "output_tokens": { "type": "integer", "minimum": 0 },
    "total_tokens": { "type": "integer", "minimum": 0 },
    "duration_ms": { "type": "number", "minimum": 0 },
    "status": { "type": "string" },
    "error": { "type": "string" },
    "user_prompt": { "type": "string" },
    "assistant_output": { "type": "string" }
  }
}
